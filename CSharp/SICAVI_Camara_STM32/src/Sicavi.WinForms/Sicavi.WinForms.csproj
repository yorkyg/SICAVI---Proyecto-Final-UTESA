<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>

		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

		<AssemblyName>SICAVI</AssemblyName>
		<RootNamespace>Sicavi.WinForms</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenCvSharp4.Windows"
						  Version="4.13.0.20260627" />

		<PackageReference Include="OpenCvSharp4.Extensions"
						  Version="4.13.0.20260627" />

		<PackageReference Include="System.IO.Ports"
						  Version="8.0.0" />

		<PackageReference Include="Microsoft.Data.SqlClient"
						  Version="7.0.2" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Forms\MainForm.cs"><SubType>Form</SubType></Compile>
		<Compile Update="Forms\MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
		<EmbeddedResource Update="Forms\MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>
		<Compile Update="Forms\LoginForm.cs"><SubType>Form</SubType></Compile>
		<Compile Update="Forms\LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
		<EmbeddedResource Update="Forms\LoginForm.resx"><DependentUpon>LoginForm.cs</DependentUpon></EmbeddedResource>
		<Compile Update="Forms\RegistrationForm.cs"><SubType>Form</SubType></Compile>
		<Compile Update="Forms\RegistrationForm.Designer.cs"><DependentUpon>RegistrationForm.cs</DependentUpon></Compile>
		<EmbeddedResource Update="Forms\RegistrationForm.resx"><DependentUpon>RegistrationForm.cs</DependentUpon></EmbeddedResource>
		<Compile Update="Forms\UserManagementForm.cs"><SubType>Form</SubType></Compile>
		<Compile Update="Forms\UserManagementForm.Designer.cs"><DependentUpon>UserManagementForm.cs</DependentUpon></Compile>
		<EmbeddedResource Update="Forms\UserManagementForm.resx"><DependentUpon>UserManagementForm.cs</DependentUpon></EmbeddedResource>
		<Compile Update="Forms\ProductionDataForm.cs"><SubType>Form</SubType></Compile>
		<Compile Update="Forms\ProductionDataForm.Designer.cs"><DependentUpon>ProductionDataForm.cs</DependentUpon></Compile>
		<EmbeddedResource Update="Forms\ProductionDataForm.resx"><DependentUpon>ProductionDataForm.cs</DependentUpon></EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="vision-settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="database-settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Database\SICAVI.sql">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
